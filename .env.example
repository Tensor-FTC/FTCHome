# ─────────────────────────────────────────────────────────────
# FTC Home — environment
#
# Every value here is OPTIONAL. With none of them set the app runs
# fully offline against local IndexedDB storage, which is the
# intended behaviour in a gym. These only add cloud sync and live
# event data on top.
# ─────────────────────────────────────────────────────────────

# Supabase — cloud sync across devices.
# Create a project at https://supabase.com, run supabase/migrations/*.sql,
# then paste the project URL and the *anon/publishable* key below.
# Never put the service_role key in this file: it ships to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# FIRST Tech Challenge Events API v2 — live rankings, schedule and results.
# Request a key at https://ftc-events.firstinspires.org/services/API
# Format is "username:authorizationKey"; the app base64-encodes it for you.
# You can also paste this at runtime in Settings → Live data, which keeps it
# out of the build entirely. That is the recommended route.
VITE_FTC_API_KEY=

# Season used for FTC Events API lookups (defaults to the current season).
VITE_FTC_SEASON=2025
