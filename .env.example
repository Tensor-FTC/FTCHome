# ─────────────────────────────────────────────────────────────
# FTC Home — environment
#
# Every value here is OPTIONAL. With none of them set the app runs
# fully offline against local IndexedDB storage, and it keeps working
# with no internet either way. These only add cloud sync on top.
#
# Full database and sign-in guide: docs/SUPABASE.md
# ─────────────────────────────────────────────────────────────

# Supabase — cloud sync across devices.
# Create a project at https://supabase.com, run every file in
# supabase/migrations/ in order,
# then paste the project URL and the *publishable* key below.
#
# Supabase now issues `sb_publishable_…` keys; older projects have a legacy
# `anon` JWT starting `eyJ…`. Either works here.
#
# Never put the secret key (`sb_secret_…`, formerly service_role) in this file:
# everything here ships to the browser, and that key bypasses row-level
# security entirely.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Competition data comes from FTCScout (https://ftcscout.org).
# There is deliberately nothing to configure: the API is public, needs no key,
# and sends permissive CORS headers, so it works from the browser out of the box.
# Season and region are chosen at runtime in Settings → Live data.
